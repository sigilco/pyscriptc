---
import { useI18n } from "../i18n";

const i18n = useI18n();
const currentLocale = i18n.nav.langLabel || "EN";

const languages = [
  { code: "EN", name: "English", active: true },
  { code: "ES", name: "Español", active: false, badge: "Soon" },
  { code: "ZH", name: "简体中文", active: false, badge: "Soon" },
];
---

<div class="lang-switch" id="lang-switch-container">
  <button
    type="button"
    class="lang-pill"
    id="lang-switch-btn"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label={`Current language: ${currentLocale}. Select language`}
  >
    <svg
      class="globe-icon"
      width="13"
      height="13"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span class="locale-label">{currentLocale}</span>
    <svg
      class="chevron-icon"
      width="10"
      height="10"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div class="lang-dropdown" id="lang-dropdown-menu" role="menu" aria-label="Languages">
    <div class="dropdown-header">Select Language</div>
    <ul class="dropdown-list">
      {
        languages.map((lang) => (
          <li>
            <button
              type="button"
              class={`dropdown-item ${lang.active ? "active" : "disabled"}`}
              role="menuitem"
              disabled={!lang.active}
            >
              <div class="item-meta">
                <span class="item-name">{lang.name}</span>
                <span class="item-code">{lang.code}</span>
              </div>
              {lang.active ? (
                <svg
                  class="check-icon"
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              ) : (
                <span class="item-badge">{lang.badge}</span>
              )}
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .lang-switch {
    position: relative;
    display: inline-block;
  }

  .lang-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.6rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-family: var(--font-mono);
    line-height: 1;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .lang-pill:hover {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-text-primary);
  }

  .lang-pill:focus-visible {
    outline: 2px solid var(--color-accent-cyan);
    outline-offset: 2px;
  }

  .globe-icon {
    opacity: 0.8;
  }

  .locale-label {
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .chevron-icon {
    opacity: 0.6;
    transition: transform 0.2s ease;
  }

  .lang-switch.is-open .chevron-icon {
    transform: rotate(180deg);
  }

  .lang-dropdown {
    display: none;
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    width: 170px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.625rem;
    padding: 0.35rem;
    box-shadow: 0 12px 28px -4px rgba(0, 0, 0, 0.6);
    z-index: 70;
    backdrop-filter: blur(16px);
  }

  .lang-switch.is-open .lang-dropdown {
    display: block;
    animation: dropdownFadeIn 0.15s ease forwards;
  }

  @keyframes dropdownFadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .dropdown-header {
    padding: 0.35rem 0.5rem 0.25rem;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .dropdown-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .dropdown-item {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.38rem 0.5rem;
    border-radius: 0.375rem;
    border: none;
    background: transparent;
    color: var(--color-text-primary);
    font-size: 0.75rem;
    cursor: pointer;
    text-align: left;
    transition: background 0.12s ease;
  }

  .dropdown-item:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.06);
  }

  .dropdown-item.active {
    color: var(--color-accent-cyan);
    font-weight: 500;
  }

  .dropdown-item.disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .item-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .item-code {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    opacity: 0.7;
  }

  .item-badge {
    font-size: 0.62rem;
    padding: 0.1rem 0.35rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .check-icon {
    color: var(--color-accent-cyan);
  }
</style>

<script>
  function setupLangSwitch() {
    const container = document.getElementById("lang-switch-container");
    const btn = document.getElementById("lang-switch-btn");

    if (!container || !btn) return;

    function toggleMenu(e) {
      e.stopPropagation();
      const isOpen = container.classList.toggle("is-open");
      btn.setAttribute("aria-expanded", isOpen ? "true" : "false");
    }

    function closeMenu() {
      container.classList.remove("is-open");
      btn.setAttribute("aria-expanded", "false");
    }

    btn.addEventListener("click", toggleMenu);

    document.addEventListener("click", (e) => {
      if (!container.contains(e.target)) {
        closeMenu();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && container.classList.contains("is-open")) {
        closeMenu();
        btn.focus();
      }
    });
  }

  setupLangSwitch();
  document.addEventListener("astro:page-load", setupLangSwitch);
</script>
