---
interface TargetSurface {
  arch: string;
  name: string;
  note: string;
  format: string;
  runtime: string;
}

const targets: TargetSurface[] = [
  {
    arch: "x86_64-linux",
    name: "Linux x86_64",
    note: "glibc & static musl",
    format: "ELF binary",
    runtime: "Zero runtime dependencies",
  },
  {
    arch: "aarch64-linux",
    name: "Linux ARM64",
    note: "AWS Graviton, Ampere, Docker",
    format: "ELF binary",
    runtime: "Zero runtime dependencies",
  },
  {
    arch: "aarch64-macos",
    name: "macOS ARM64",
    note: "Apple Silicon (M1/M2/M3/M4)",
    format: "Mach-O binary",
    runtime: "Native Metal & CoreFoundation",
  },
  {
    arch: "x86_64-macos",
    name: "macOS Intel",
    note: "Universal binary compatible",
    format: "Mach-O binary",
    runtime: "Native execution",
  },
  {
    arch: "x86_64-windows",
    name: "Windows x86_64",
    note: "MSVC / MinGW compatible",
    format: "PE executable (.exe)",
    runtime: "Native Windows subsystems",
  },
  {
    arch: "wasm32-wasi",
    name: "WebAssembly Edge",
    note: "Cloudflare Workers, Fastly, Browsers",
    format: "WASM module",
    runtime: "Sandboxed WASI runtime",
  },
];
---

<section class="w-full max-w-6xl mx-auto px-6 py-20 lg:py-28 text-left" id="deploy">
  <!-- Minimal Header without chips -->
  <div class="max-w-3xl mb-12">
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-normal tracking-tight text-white leading-[1.12] mb-4">
      Deploy anywhere.
    </h2>
    <p class="text-base sm:text-lg text-slate-400 font-light leading-relaxed">
      Cross-compile standalone executables for any cloud, desktop, or edge platform with a single target flag.
      Zero external C toolchain configuration required.
    </p>
  </div>

  <!-- Minimalist Listing Table / List Component -->
  <div class="w-full divide-y divide-white/10 border-t border-b border-white/10 font-mono text-xs">
    {
      targets.map((t) => (
        <div class="py-4.5 sm:py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-6 hover:bg-white/[0.015] transition-colors">
          <div class="flex items-center gap-3 min-w-[200px]">
            <span class="text-white font-semibold text-sm font-sans">{t.name}</span>
            <span class="text-slate-500 font-mono text-xs">({t.arch})</span>
          </div>

          <div class="text-slate-400 font-light text-xs sm:flex-1">
            {t.note}
          </div>

          <div class="flex items-center gap-6 sm:justify-end text-slate-400 text-xs">
            <span class="text-slate-300">{t.format}</span>
            <span class="text-slate-500 hidden md:inline">·</span>
            <span class="text-slate-400 hidden md:inline">{t.runtime}</span>
            <span class="text-slate-400">✓ Built-in</span>
          </div>
        </div>
      ))
    }
  </div>
</section>
