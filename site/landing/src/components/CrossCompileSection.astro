---
interface TargetSurface {
  arch: string;
  name: string;
  note: string;
  format: string;
  runtime: string;
}

const targets: TargetSurface[] = [
  {
    arch: "x86_64-linux",
    name: "Linux x86_64",
    note: "glibc & static musl",
    format: "ELF binary",
    runtime: "Zero runtime dependencies",
  },
  {
    arch: "aarch64-linux",
    name: "Linux ARM64",
    note: "AWS Graviton, Ampere, Docker",
    format: "ELF binary",
    runtime: "Zero runtime dependencies",
  },
  {
    arch: "aarch64-macos",
    name: "macOS ARM64",
    note: "Apple Silicon (M1–M4)",
    format: "Mach-O binary",
    runtime: "Native Metal & CoreFoundation",
  },
  {
    arch: "x86_64-macos",
    name: "macOS Intel",
    note: "Universal binary compatible",
    format: "Mach-O binary",
    runtime: "Native execution",
  },
  {
    arch: "x86_64-windows",
    name: "Windows x86_64",
    note: "MSVC / MinGW compatible",
    format: "PE executable (.exe)",
    runtime: "Native Windows subsystems",
  },
  {
    arch: "wasm32-wasi",
    name: "WebAssembly Edge",
    note: "Cloudflare Workers, Fastly, Browsers",
    format: "WASM module",
    runtime: "Sandboxed WASI runtime",
  },
];
---

<section class="w-full max-w-6xl mx-auto px-6 py-20 lg:py-28 text-left" id="deploy">
  <!-- Minimal Header without chips -->
  <div class="max-w-3xl mb-12">
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-normal tracking-tight text-white leading-[1.12] mb-4">
      Deploy anywhere.
    </h2>
    <p class="text-base sm:text-lg text-slate-400 font-light leading-relaxed">
      Cross-compile standalone executables for any cloud, desktop, or edge platform with a single target flag.
      Zero external C toolchain configuration required.
    </p>
  </div>

  <!-- Minimal Table (no heavy borders, clean tabular data) -->
  <div class="w-full overflow-x-auto">
    <table class="w-full border-collapse text-left font-mono text-xs">
      <thead>
        <tr class="border-b border-white/10 text-slate-500 uppercase tracking-wider text-[11px]">
          <th class="py-3 pr-4 font-medium">Architecture</th>
          <th class="py-3 px-4 font-medium">Platform</th>
          <th class="py-3 px-4 font-medium">Environment</th>
          <th class="py-3 px-4 font-medium">Format</th>
          <th class="py-3 pl-4 font-medium text-right">Toolchain</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/5 text-slate-300">
        {
          targets.map((t) => (
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="py-4 pr-4 font-bold text-white whitespace-nowrap">{t.arch}</td>
              <td class="py-4 px-4 font-sans text-sm text-slate-200 whitespace-nowrap">{t.name}</td>
              <td class="py-4 px-4 text-slate-400">{t.note}</td>
              <td class="py-4 px-4 text-slate-300 whitespace-nowrap">{t.format}</td>
              <td class="py-4 pl-4 text-right whitespace-nowrap text-cyan-400 font-semibold">
                ✓ Built-in
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
