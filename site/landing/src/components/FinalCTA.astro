---
import { siteLinks } from "../config/links";
import { useI18n } from "../i18n";

const i18n = useI18n();
const c = i18n.cta;
---

<section class="final-cta-section" aria-labelledby="cta-heading">
  <div class="final-cta-container">
    <div class="cta-card">
      <div class="cta-glow" aria-hidden="true"></div>
      
      <div class="cta-inner">
        <h2 id="cta-heading" class="cta-title">{c.title}</h2>
        <p class="cta-subtitle">{c.subtitle}</p>

        <div class="cta-actions">
          <a href={siteLinks.docs} class="btn btn-primary">
            <span>{c.primaryBtn}</span>
            <svg class="btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <a href={siteLinks.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <svg class="btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"></path>
            </svg>
            <span>{c.secondaryBtn}</span>
          </a>
        </div>

        <div class="cta-install-hint">
          <span class="install-prompt">$</span>
          <span class="install-code">uv tool install pyscriptc</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    position: relative;
    width: 100%;
    padding: 6rem 1.5rem;
    z-index: 10;
  }

  .final-cta-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .cta-card {
    position: relative;
    background: linear-gradient(180deg, rgba(11, 15, 25, 0.9) 0%, rgba(6, 8, 13, 0.95) 100%);
    border: 1px solid var(--color-border, rgba(255, 255, 255, 0.1));
    border-radius: 24px;
    padding: 4.5rem 2rem;
    text-align: center;
    overflow: hidden;
    box-shadow: 0 24px 60px -15px rgba(0, 0, 0, 0.7),
                0 0 0 1px rgba(0, 194, 255, 0.1);
  }

  .cta-glow {
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 450px;
    height: 300px;
    background: radial-gradient(circle, rgba(0, 194, 255, 0.25) 0%, rgba(2, 132, 199, 0.05) 50%, transparent 70%);
    pointer-events: none;
    filter: blur(40px);
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    max-width: 650px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-text-primary, #ffffff);
    margin: 0 0 1.25rem;
  }

  .cta-subtitle {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-text-secondary, #94a3b8);
    margin: 0 0 2.5rem;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2.25rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.85rem 1.65rem;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: var(--color-accent-cyan, #00c2ff);
    color: #06080d;
    box-shadow: 0 0 24px -4px rgba(0, 194, 255, 0.5);
  }

  .btn-primary:hover {
    background: #38bdf8;
    transform: translateY(-2px);
    box-shadow: 0 0 32px -2px rgba(0, 194, 255, 0.7);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--color-border, rgba(255, 255, 255, 0.15));
    color: var(--color-text-primary, #ffffff);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
  }

  .cta-install-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
    border-radius: 8px;
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
  }

  .install-prompt {
    color: var(--color-accent-cyan, #00c2ff);
    font-weight: 700;
    user-select: none;
  }

  .install-code {
    color: var(--color-text-secondary, #94a3b8);
  }
</style>
