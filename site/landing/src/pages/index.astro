---
// The landing page is intentionally blank: a title and the logo, nothing else.
// The owner designs it later; this page only holds the slot and proves the
// build works. Keep it that way until then.
import "../styles/global.css";

const title = "pyscriptc";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Compile annotated Python to a native binary. No CPython at runtime." />
    <link rel="icon" type="image/png" href="/icon-64.png" />
  </head>
  <body>
    <main>
      <img src="/logo-256.png" alt="pyscriptc" width="128" height="128" />
      <h1>{title}</h1>
    </main>
  </body>
</html>
