---
import HeaderPillNav from "../components/HeaderPillNav";
import HeroMinimal from "../components/HeroMinimal";
import BenchmarkRow from "../components/BenchmarkRow";
import LumioCarousel from "../components/LumioCarousel";
import IsometricSurfaceStack from "../components/IsometricSurfaceStack";
import CrossCompileSection from "../components/CrossCompileSection.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
import PlaygroundModal from "../components/PlaygroundModal.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>pyscriptc — Python to Native Compiler</title>
    <meta
      name="description"
      content="Compile standard annotated Python to standalone native binaries. Zero CPython at runtime."
    />
    <link rel="icon" type="image/png" sizes="64x64" href="/icon-64.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/logo-256.png" />
    <link rel="apple-touch-icon" sizes="256x256" href="/logo-256.png" />
    <link rel="shortcut icon" href="/icon-64.png" />
    <meta property="og:title" content="pyscriptc — Python to Native Compiler" />
    <meta
      property="og:description"
      content="Compile standard annotated Python to standalone native binaries. Zero CPython at runtime."
    />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="pyscriptc — Python to Native Compiler" />
    <meta
      name="twitter:description"
      content="Compile standard annotated Python to standalone native binaries. Zero CPython at runtime."
    />
  </head>
  <body class="bg-[#0b0c10] text-slate-200 antialiased font-sans selection:bg-cyan-500/20 selection:text-cyan-200 min-h-screen">
    <!-- Floating Pill Navigation Bar (KISS, without Get Started button) -->
    <HeaderPillNav client:load />

    <main id="main-content" class="relative overflow-x-hidden flex flex-col w-full">
      <!-- Section 0: Hero with Initial V3 MUJI Typography and Animated Background Mesh -->
      <HeroMinimal client:load />

      <!-- Section 1: 1x3 Vertical Rectangular Bar Charts (Throughput, RSS, Cold Start) -->
      <section class="w-full border-t border-white/5">
        <BenchmarkRow client:visible />
      </section>

      <!-- Section 2: Full Python Semantics Lumio Vertical Carousel & OnOrca Minimal Terminal -->
      <section class="w-full border-t border-white/5">
        <LumioCarousel client:visible />
      </section>

      <!-- Section 3: Three Surfaces Architectural Stack (No chips, No selectable cards, Loops forever) -->
      <section class="w-full border-t border-white/5">
        <IsometricSurfaceStack client:visible />
      </section>

      <!-- Section 4: Deploy Anywhere (Minimalist Listing, No chips, No cards) -->
      <section class="w-full border-t border-white/5">
        <CrossCompileSection />
      </section>

      <!-- Section 5: Minimal Final Call to Action (CTA + GitHub, KISS) -->
      <section class="w-full border-t border-white/5">
        <FinalCTA />
      </section>
    </main>

    <!-- Footer with Made with ❤️ from Spain -->
    <Footer />
    <PlaygroundModal />
  </body>
</html>
