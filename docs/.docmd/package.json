{
  "name": "pyscriptc-site",
  "private": true,
  "version": "0.0.0",
  "description": "The docmd docs part of the pyscriptc site",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "docs:dev": "docmd dev --config docmd.config.js",
    "docs:build": "docmd build --config docmd.config.js",
    "docs:validate": "pnpm --dir ../../apps/web run docs:validate",
    "docs:internal": "docmd dev --config docmd.internal.config.js"
  },
  "devDependencies": {
    "@docmd/core": "^0.9.5"
  },
  "dependencies": {
    "@docmd/plugin-ai": "0.9.8"
  }
}
