# Vendored surface for the lowered subset (the compiler's closed email
# rows): typeshed types `Message.walk` as a generator of `Message` and
# `get_payload` as a union this subset narrows. The stub pins the read
# surface the lowerer accepts (issue #1228).
from typing import Optional, Union

__all__ = ["message_from_bytes", "message_from_file", "message_from_string", "Message"]


class Message:
    def get(self, name: str) -> Optional[str]: ...
    def get_all(self, name: str) -> list[str]: ...
    def keys(self) -> list[str]: ...
    def items(self) -> list[tuple[str, str]]: ...
    def walk(self) -> list[Message]: ...
    def get_payload(self, decode: bool = False) -> Union[str, bytes]: ...
    def get_content_type(self) -> str: ...
    def get_filename(self) -> Optional[str]: ...
    def is_multipart(self) -> bool: ...
    def as_string(self) -> str: ...


def message_from_string(s: str) -> Message: ...
def message_from_bytes(s: bytes) -> Message: ...
def message_from_file(fp: object) -> Message: ...
