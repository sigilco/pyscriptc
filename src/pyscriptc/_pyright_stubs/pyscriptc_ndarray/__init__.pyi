# Vendored stub for the lowered pyscriptc_ndarray surface (the `pyscriptc-ndarray` pack).
# The pack lowers a contiguous typed array over a flat buffer, with the arithmetic in the
# runtime's C loop (issue #496, M1; the closed subset in restlower/_ndarray.py). Every
# name outside the subset stays fenced at the call site.
from typing import Any

__all__ = [
    "ndarray",
    "array",
    "zeros",
    "ones",
    "full",
    "arange",
    "linspace",
    "concatenate",
    "stack",
    "int32",
    "int64",
    "float32",
    "float64",
]

class ndarray:
    """A contiguous typed array: a flat buffer of fixed-width elements."""
    @property
    def shape(self) -> list[int]: ...
    @property
    def ndim(self) -> int: ...
    @property
    def size(self) -> int: ...
    @property
    def nbytes(self) -> int: ...
    @property
    def dtype(self) -> str: ...
    def sum(self, axis: int = ...) -> Any: ...
    def min(self, axis: int = ...) -> Any: ...
    def max(self, axis: int = ...) -> Any: ...
    def mean(self, axis: int = ...) -> Any: ...
    def std(self, axis: int = ...) -> Any: ...
    def var(self, axis: int = ...) -> Any: ...
    def argmin(self) -> int: ...
    def argmax(self) -> int: ...
    def reshape(self, *shape: int) -> ndarray: ...
    def ravel(self) -> ndarray: ...
    def astype(self, dtype: str) -> ndarray: ...
    def copy(self) -> ndarray: ...
    def transpose(self) -> ndarray: ...
    def tolist(self) -> Any: ...
    def tobytes(self) -> bytes: ...
    def __add__(self, other: Any) -> ndarray: ...
    def __sub__(self, other: Any) -> ndarray: ...
    def __mul__(self, other: Any) -> ndarray: ...
    def __truediv__(self, other: Any) -> ndarray: ...
    def __floordiv__(self, other: Any) -> ndarray: ...
    def __mod__(self, other: Any) -> ndarray: ...
    def __lt__(self, other: Any) -> ndarray: ...
    def __le__(self, other: Any) -> ndarray: ...
    def __gt__(self, other: Any) -> ndarray: ...
    def __ge__(self, other: Any) -> ndarray: ...
    def __eq__(self, other: Any) -> ndarray: ...  # type: ignore[override]
    def __ne__(self, other: Any) -> ndarray: ...  # type: ignore[override]
    def __getitem__(self, key: Any) -> Any: ...
    def __setitem__(self, key: Any, value: Any) -> None: ...

def array(dtype: str, data: list[Any]) -> ndarray: ...
def zeros(*shape: int, dtype: str = ...) -> ndarray: ...
def ones(*shape: int, dtype: str = ...) -> ndarray: ...
def full(shape: Any, value: Any, dtype: str = ...) -> ndarray: ...
def arange(*args: Any, dtype: str = ...) -> ndarray: ...
def linspace(start: float, stop: float, num: int, dtype: str = ...) -> ndarray: ...
def fromlist(data: list[Any], dtype: str = ...) -> ndarray: ...
def concatenate(arrays: Any) -> ndarray: ...
def stack(arrays: Any) -> ndarray: ...

int32: str
int64: str
float32: str
float64: str
