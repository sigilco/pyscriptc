# Vendored stub for the lowered pyscriptc_frame surface (the `pyscriptc-frame` pack).
# The pack lowers a columnar frame over the ndarray buffers, with the ops in the
# runtime's C (issue #497, slice 1; the closed subset in restlower/_frame.py). Every
# name outside the subset stays fenced at the call site.
from typing import Any

from pyscriptc_ndarray import ndarray

__all__ = [
    "DataFrame",
]


class DataFrame:
    """A columnar frame: a dict of named columns, each column an ndarray."""
    def __init__(self, data: dict[str, list[Any]]) -> None: ...
    @property
    def columns(self) -> list[str]: ...
    @property
    def shape(self) -> tuple[int, int]: ...
    def head(self, n: int = ...) -> DataFrame: ...
    def tail(self, n: int = ...) -> DataFrame: ...
    def to_dict(self) -> dict[str, list[Any]]: ...
    def __getitem__(self, name: str) -> ndarray: ...
    def __setitem__(self, name: str, values: ndarray) -> None: ...
    def __len__(self) -> int: ...
