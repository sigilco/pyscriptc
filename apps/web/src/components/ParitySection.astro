---
import { useI18n } from "../i18n";

const i18n = useI18n();
const p = i18n.parity;
---

<section class="parity-section" id="parity" aria-labelledby="parity-heading">
  <div class="parity-container">
    <div class="section-header">
      <div class="section-badge">
        <span class="badge-dot"></span>
        <span class="badge-text">{p.badge}</span>
      </div>
      <h2 id="parity-heading" class="section-title">{p.title}</h2>
      <p class="section-subtitle">{p.subtitle}</p>
    </div>

    <div class="parity-grid">
      <!-- Left Card: Terminal Code & Execution (7 cols) -->
      <div class="terminal-card">
        <div class="terminal-header">
          <div class="window-controls" aria-hidden="true">
            <span class="dot close"></span>
            <span class="dot minimize"></span>
            <span class="dot expand"></span>
          </div>
          <div class="terminal-tab">
            <svg class="file-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
              <polyline points="13 2 13 9 20 9"></polyline>
            </svg>
            <span class="tab-title">{p.terminalFile}</span>
          </div>
          <div class="terminal-badge">{p.terminalTag}</div>
        </div>

        <div class="terminal-body">
          <pre class="code-block"><code><span class="code-kw">def</span> <span class="code-fn">sum_squares</span>(n: <span class="code-type">int</span>) -&gt; <span class="code-type">int</span>:
    total: <span class="code-type">int</span> = <span class="code-num">0</span>
    <span class="code-kw">for</span> i <span class="code-kw">in</span> <span class="code-builtin">range</span>(<span class="code-num">1</span>, n + <span class="code-num">1</span>):
        total += i * i
    <span class="code-kw">return</span> total

<span class="code-kw">if</span> __name__ == <span class="code-str">"__main__"</span>:
    <span class="code-builtin">print</span>(sum_squares(<span class="code-num">1_000_000</span>))</code></pre>

          <div class="terminal-divider"></div>

          <div class="terminal-cli">
            <div class="cli-step">
              <span class="prompt-sym">$</span>
              <span class="cli-cmd">{p.terminalRun}</span>
            </div>
            <div class="cli-output">
              <span class="step-icon">✔</span>
              <span class="step-text">{p.terminalStep1}</span>
            </div>
            <div class="cli-output">
              <span class="step-icon">✔</span>
              <span class="step-text">{p.terminalStep2}</span>
            </div>

            <div class="cli-step exec-step">
              <span class="prompt-sym">$</span>
              <span class="cli-cmd">{p.terminalExec}</span>
            </div>
            <div class="cli-result">
              <span class="result-value">333333833333500000</span>
              <div class="speedup-pill">
                <span class="perf-highlight">{p.terminalPerf}</span>
                <span class="perf-vs">{p.terminalVs}</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Card: Deterministic & Predictability Guarantee (5 cols) -->
      <div class="guarantee-card">
        <div class="guarantee-header">
          <div class="guarantee-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span>{p.guaranteeTag}</span>
          </div>
          <h3 class="guarantee-title">{p.guaranteeTitle}</h3>
        </div>

        <p class="guarantee-desc">{p.guaranteeDesc}</p>

        <div class="feature-list">
          <div class="feature-item">
            <div class="feature-icon-box">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <polyline points="9 12 11 14 15 10"></polyline>
              </svg>
            </div>
            <div class="feature-content">
              <h4 class="feature-title">{p.semTitle}</h4>
              <p class="feature-desc">{p.semDesc}</p>
            </div>
          </div>

          <div class="feature-item">
            <div class="feature-icon-box cyan">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            </div>
            <div class="feature-content">
              <h4 class="feature-title">{p.diagTitle}</h4>
              <p class="feature-desc">{p.diagDesc}</p>
            </div>
          </div>

          <div class="feature-item">
            <div class="feature-icon-box yellow">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polyline>
              </svg>
            </div>
            <div class="feature-content">
              <h4 class="feature-title">Zero Warmup & No JIT Deopts</h4>
              <p class="feature-desc">Native machine code from the very first instruction. Steady latency without tracing pauses or bailouts.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .parity-section {
    position: relative;
    width: 100%;
    padding: 5rem 1.5rem;
    z-index: 10;
  }

  .parity-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3.5rem;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: rgba(0, 194, 255, 0.08);
    border: 1px solid rgba(0, 194, 255, 0.25);
    margin-bottom: 1.25rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent-cyan, #00c2ff);
    box-shadow: 0 0 8px var(--color-accent-cyan, #00c2ff);
  }

  .badge-text {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent-cyan, #00c2ff);
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-text-primary, #ffffff);
    margin: 0 0 1rem;
  }

  .section-subtitle {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-secondary, #94a3b8);
    margin: 0;
  }

  /* Grid layout: 7 cols vs 5 cols */
  .parity-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 960px) {
    .parity-grid {
      grid-template-columns: 7fr 5fr;
      align-items: stretch;
    }
  }

  /* Left Card: Terminal */
  .terminal-card {
    background: #090d16;
    border: 1px solid var(--color-border, rgba(255, 255, 255, 0.1));
    border-radius: 16px;
    box-shadow: 0 16px 40px -10px rgba(0, 0, 0, 0.5),
                0 0 0 1px rgba(0, 194, 255, 0.1);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
  }

  .window-controls {
    display: flex;
    gap: 6px;
  }

  .window-controls .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .window-controls .close { background: #ef4444; }
  .window-controls .minimize { background: #eab308; }
  .window-controls .expand { background: #22c55e; }

  .terminal-tab {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    color: var(--color-text-secondary, #94a3b8);
  }

  .file-icon {
    color: var(--color-accent-cyan, #00c2ff);
  }

  .terminal-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-text-muted, #64748b);
  }

  .terminal-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    font-family: var(--font-mono, monospace);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .code-block {
    margin: 0;
    overflow-x: auto;
  }

  .code-kw { color: #f472b6; font-weight: 600; }
  .code-fn { color: #38bdf8; font-weight: 600; }
  .code-type { color: #2dd4bf; }
  .code-num { color: #fbbf24; }
  .code-builtin { color: #c084fc; }
  .code-str { color: #a3e635; }

  .terminal-divider {
    height: 1px;
    background: var(--color-border, rgba(255, 255, 255, 0.08));
    margin: 1.25rem 0;
  }

  .terminal-cli {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cli-step {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-text-primary, #ffffff);
    font-weight: 500;
  }

  .exec-step {
    margin-top: 0.5rem;
  }

  .prompt-sym {
    color: var(--color-accent-cyan, #00c2ff);
    font-weight: 700;
    user-select: none;
  }

  .cli-cmd {
    color: #e2e8f0;
  }

  .cli-output {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-text-secondary, #94a3b8);
    padding-left: 1.15rem;
  }

  .step-icon {
    color: #22c55e;
    font-size: 0.8rem;
  }

  .cli-result {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-left: 1.15rem;
    margin-top: 0.25rem;
  }

  .result-value {
    color: #94a3b8;
    font-weight: 600;
  }

  .speedup-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: 9999px;
  }

  .perf-highlight {
    color: #4ade80;
    font-weight: 700;
    font-size: 0.8rem;
  }

  .perf-vs {
    color: #86efac;
    font-size: 0.75rem;
  }

  /* Right Card: Guarantees */
  .guarantee-card {
    background: var(--color-bg-card, rgba(17, 22, 37, 0.75));
    border: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
    border-radius: 16px;
    padding: 2.25rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    box-shadow: 0 16px 40px -10px rgba(0, 0, 0, 0.4);
  }

  .guarantee-header {
    margin-bottom: 1rem;
  }

  .guarantee-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    background: rgba(251, 191, 36, 0.1);
    border: 1px solid rgba(251, 191, 36, 0.3);
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 600;
    color: #fbbf24;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.75rem;
  }

  .guarantee-title {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary, #ffffff);
    margin: 0;
  }

  .guarantee-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-secondary, #94a3b8);
    margin: 0 0 2rem;
  }

  .feature-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: auto;
  }

  .feature-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .feature-icon-box {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #38bdf8;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-icon-box.cyan {
    background: rgba(0, 194, 255, 0.1);
    border-color: rgba(0, 194, 255, 0.25);
    color: var(--color-accent-cyan, #00c2ff);
  }

  .feature-icon-box.yellow {
    background: rgba(251, 191, 36, 0.1);
    border-color: rgba(251, 191, 36, 0.25);
    color: #fbbf24;
  }

  .feature-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .feature-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-primary, #ffffff);
    margin: 0;
  }

  .feature-desc {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-text-secondary, #94a3b8);
    margin: 0;
  }
</style>
