---
import { siteLinks } from "../config/links";
import { useI18n } from "../i18n";

const i18n = useI18n();
---

<section class="w-full max-w-4xl mx-auto px-6 py-24 sm:py-32 text-center" aria-labelledby="cta-heading">
  <h2 id="cta-heading" class="text-3xl sm:text-4xl lg:text-5xl font-normal tracking-tight text-white leading-tight mb-4">
    Ready to ship Python as native code?
  </h2>
  <p class="text-base sm:text-lg text-slate-400 font-light max-w-xl mx-auto leading-relaxed mb-8">
    Start compiling standard typed Python into standalone executables in under two minutes.
  </p>

  <div class="flex flex-wrap items-center justify-center gap-4">
    <a
      href={siteLinks.docs}
      class="px-6 py-3 rounded-full bg-white text-black font-medium text-xs hover:bg-slate-200 transition-all shadow-sm"
    >
      Read the documentation ↗
    </a>
    <a
      href={siteLinks.sponsor}
      target="_blank"
      rel="noopener noreferrer"
      class="px-6 py-3 rounded-full bg-[#db2777] text-white font-medium text-xs hover:bg-[#be185d] transition-all shadow-sm flex items-center gap-2"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
      </svg>
      <span>{i18n.cta.sponsorBtn}</span>
    </a>
    <a
      href={siteLinks.github}
      target="_blank"
      rel="noopener noreferrer"
      class="px-6 py-3 rounded-full bg-white/5 border border-white/10 text-white font-medium text-xs hover:bg-white/10 transition-all flex items-center gap-2"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"></path>
      </svg>
      <span>GitHub</span>
    </a>
  </div>
</section>
