---
// Tactile Python Package Constellation
// Uses 23 popular Python packages, active glowing hotspots in Python blue & yellow,
// subtle star sparkles (✦), 24px dot-matrix overlay, and reduced-motion accessibility.

interface Hotspot {
  name: string;
  color: "blue" | "yellow";
  top: string;
  left: string;
  delay: string;
  size?: "sm" | "md" | "lg";
}

interface FaintWord {
  name: string;
  top: string;
  left: string;
  rotate?: string;
  size?: string;
}

const hotspots: Hotspot[] = [
  { name: "numpy", color: "blue", top: "18%", left: "62%", delay: "0s", size: "lg" },
  { name: "torch", color: "yellow", top: "28%", left: "82%", delay: "1.2s", size: "md" },
  { name: "fastapi", color: "blue", top: "42%", left: "55%", delay: "0.6s", size: "lg" },
  { name: "pydantic", color: "yellow", top: "52%", left: "78%", delay: "1.8s", size: "md" },
  { name: "polars", color: "blue", top: "68%", left: "65%", delay: "2.4s", size: "md" },
  { name: "duckdb", color: "yellow", top: "35%", left: "70%", delay: "0.9s", size: "sm" },
  { name: "httpx", color: "blue", top: "12%", left: "78%", delay: "1.5s", size: "sm" },
  { name: "rich", color: "yellow", top: "62%", left: "86%", delay: "2.1s", size: "sm" },
];

const faintWords: FaintWord[] = [
  { name: "django", top: "8%", left: "45%", rotate: "-4deg", size: "0.85rem" },
  { name: "flask", top: "25%", left: "48%", rotate: "3deg", size: "0.8rem" },
  { name: "requests", top: "14%", left: "88%", rotate: "-2deg", size: "0.9rem" },
  { name: "pandas", top: "32%", left: "60%", rotate: "2deg", size: "0.95rem" },
  { name: "scikit-learn", top: "46%", left: "88%", rotate: "-3deg", size: "0.8rem" },
  { name: "pytest", top: "58%", left: "52%", rotate: "4deg", size: "0.85rem" },
  { name: "click", top: "75%", left: "75%", rotate: "-2deg", size: "0.8rem" },
  { name: "sqlalchemy", top: "22%", left: "73%", rotate: "-1deg", size: "0.82rem" },
  { name: "celery", top: "82%", left: "62%", rotate: "3deg", size: "0.78rem" },
  { name: "aiohttp", top: "80%", left: "82%", rotate: "-4deg", size: "0.82rem" },
  { name: "typer", top: "38%", left: "45%", rotate: "2deg", size: "0.85rem" },
  { name: "alembic", top: "65%", left: "45%", rotate: "-3deg", size: "0.78rem" },
  { name: "scipy", top: "10%", left: "68%", rotate: "1deg", size: "0.9rem" },
  { name: "matplotlib", top: "48%", left: "70%", rotate: "-2deg", size: "0.8rem" },
  { name: "beautifulsoup4", top: "88%", left: "72%", rotate: "2deg", size: "0.75rem" },
];
---

<div class="hero-constellation-container" aria-hidden="true">
  <!-- 24px dot-matrix overlay -->
  <div class="dot-matrix dot-grid"></div>

  <!-- Radial gradient spotlight in the constellation region -->
  <div class="constellation-glow"></div>

  <!-- Connecting constellation lines (SVG) -->
  <svg class="constellation-svg" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="lineGradBlue" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.3" />
        <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.05" />
      </linearGradient>
      <linearGradient id="lineGradYellow" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#fbbf24" stop-opacity="0.3" />
        <stop offset="100%" stop-color="#fbbf24" stop-opacity="0.05" />
      </linearGradient>
    </defs>
    <!-- Organic constellation links between key packages -->
    <line x1="62%" y1="18%" x2="55%" y2="42%" stroke="url(#lineGradBlue)" stroke-width="1" stroke-dasharray="3 3" />
    <line x1="62%" y1="18%" x2="70%" y2="35%" stroke="url(#lineGradBlue)" stroke-width="1" stroke-dasharray="2 4" />
    <line x1="70%" y1="35%" x2="82%" y2="28%" stroke="url(#lineGradYellow)" stroke-width="1" stroke-dasharray="3 3" />
    <line x1="55%" y1="42%" x2="65%" y2="68%" stroke="url(#lineGradBlue)" stroke-width="1" stroke-dasharray="4 4" />
    <line x1="70%" y1="35%" x2="78%" y2="52%" stroke="url(#lineGradYellow)" stroke-width="1" stroke-dasharray="2 3" />
    <line x1="78%" y1="52%" x2="86%" y2="62%" stroke="url(#lineGradYellow)" stroke-width="1" stroke-dasharray="3 3" />
    <line x1="65%" y1="68%" x2="86%" y2="62%" stroke="url(#lineGradBlue)" stroke-width="1" stroke-dasharray="4 4" />
  </svg>

  <!-- Ambient faint words -->
  <div class="faint-words-layer">
    {
      faintWords.map((word) => (
        <span
          class="faint-word-node faint-word"
          style={`top: ${word.top}; left: ${word.left}; transform: rotate(${word.rotate || "0deg"}); font-size: ${word.size || "0.85rem"};`}
        >
          {word.name}
        </span>
      ))
    }
  </div>

  <!-- Active glowing hotspots -->
  <div class="hotspots-layer">
    {
      hotspots.map((spot) => (
        <div
          class={`hotspot-node pulse-anim ${spot.color === "blue" ? "glow-cyan hotspot-blue" : "glow-yellow hotspot-yellow"} size-${spot.size || "md"}`}
          style={`top: ${spot.top}; left: ${spot.left}; animation-delay: ${spot.delay};`}
        >
          <span class="hotspot-sparkle">✦</span>
          <span class="hotspot-name">{spot.name}</span>
        </div>
      ))
    }
  </div>

  <!-- Soft vignette protecting lower-left hero copy -->
  <div class="hero-mask-vignette"></div>
</div>

<style>
  .hero-constellation-container {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  /* 24px dot-matrix overlay */
  .dot-matrix {
    position: absolute;
    inset: 0;
    opacity: 0.7;
    mask-image: radial-gradient(ellipse 90% 80% at 70% 35%, black 40%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 90% 80% at 70% 35%, black 40%, transparent 80%);
  }

  /* Atmospheric glow behind constellation */
  .constellation-glow {
    position: absolute;
    top: 10%;
    right: 10%;
    width: 600px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(0, 194, 255, 0.08) 0%,
      rgba(251, 191, 36, 0.04) 40%,
      transparent 70%
    );
    filter: blur(60px);
  }

  /* Constellation vector lines */
  .constellation-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.6;
  }

  /* Ambient Faint Words */
  .faint-words-layer {
    position: absolute;
    inset: 0;
  }

  .faint-word-node {
    position: absolute;
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
    opacity: 0.045;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: opacity 0.3s ease;
  }

  /* Active Hotspots */
  .hotspots-layer {
    position: absolute;
    inset: 0;
  }

  .hotspot-node {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.22rem 0.55rem;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .hotspot-blue {
    background: rgba(14, 165, 233, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.35);
    color: #38bdf8;
  }

  .hotspot-yellow {
    background: rgba(251, 191, 36, 0.09);
    border: 1px solid rgba(251, 191, 36, 0.35);
    color: #fbbf24;
  }

  .size-sm {
    font-size: 0.7rem;
    padding: 0.18rem 0.45rem;
  }

  .size-md {
    font-size: 0.78rem;
    padding: 0.22rem 0.55rem;
  }

  .size-lg {
    font-size: 0.88rem;
    padding: 0.28rem 0.7rem;
  }

  .hotspot-sparkle {
    font-size: 0.65rem;
    opacity: 0.85;
    animation: sparkleRotate 4s ease-in-out infinite;
  }

  @keyframes sparkleRotate {
    0%, 100% {
      transform: scale(0.9) rotate(0deg);
      opacity: 0.7;
    }
    50% {
      transform: scale(1.2) rotate(45deg);
      opacity: 1;
    }
  }

  /* Soft Vignette protecting lower-left hero text */
  .hero-mask-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 20% 80%,
      var(--color-bg-base) 15%,
      rgba(6, 8, 13, 0.85) 45%,
      transparent 80%
    );
    pointer-events: none;
  }

  /* Mobile responsiveness */
  @media (max-width: 860px) {
    .faint-word-node {
      display: none;
    }

    .constellation-svg {
      opacity: 0.35;
    }

    .hotspot-node {
      transform: scale(0.85);
    }

    /* Shift hotspots slightly upwards so they don't crowd lower-left */
    .hotspots-layer {
      top: -10%;
      right: -5%;
    }
  }

  @media (max-width: 540px) {
    .constellation-glow {
      width: 320px;
      height: 300px;
    }

    .hotspot-node.size-sm {
      display: none;
    }
  }

  /* Accessibility: Prefers Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .pulse-anim {
      animation: none !important;
      transform: none !important;
    }

    .hotspot-sparkle {
      animation: none !important;
      transform: none !important;
    }
  }
</style>
