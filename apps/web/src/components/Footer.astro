---
import { siteLinks } from "../config/links";
import { useI18n } from "../i18n";

const i18n = useI18n();
const f = i18n.footer;
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="brand-link" aria-label="pyscriptc home">
          <img src="/logo-256.png" alt="pyscriptc logo" width="32" height="32" class="brand-logo" />
          <span class="brand-name">pyscriptc</span>
        </a>
        <p class="brand-tagline">{f.tagline}</p>
      </div>

      <div class="footer-nav-grid">
        <div class="nav-col">
          <h4 class="nav-heading">Product</h4>
          <ul class="nav-list">
            <li><a href={siteLinks.docs} class="nav-link">Documentation</a></li>
            <li><a href={siteLinks.compat} class="nav-link">Are We Native Yet?</a></li>
            <li><a href={siteLinks.playground} class="nav-link">Web Playground</a></li>
          </ul>
        </div>

        <div class="nav-col">
          <h4 class="nav-heading">Ecosystem</h4>
          <ul class="nav-list">
            <li><a href={siteLinks.github} target="_blank" rel="noopener noreferrer" data-ph-event="outbound_click" data-ph-label="footer_github" class="nav-link">GitHub</a></li>
            <li><a href={siteLinks.pypi} target="_blank" rel="noopener noreferrer" data-ph-event="outbound_click" data-ph-label="footer_pypi" class="nav-link">PyPI Package</a></li>
            <li><a href={siteLinks.x} target="_blank" rel="noopener noreferrer" data-ph-event="outbound_click" data-ph-label="footer_x" class="nav-link">X / Twitter</a></li>
          </ul>
        </div>

        <div class="nav-col">
          <h4 class="nav-heading">Project</h4>
          <ul class="nav-list">
            <li><a href={siteLinks.license} target="_blank" rel="noopener noreferrer" class="nav-link">Apache-2.0 License</a></li>
            <li><a href={siteLinks.privacy} class="nav-link">Privacy</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-made-with">
        <span>Made with</span>
        <span class="heart-icon" aria-label="love">❤️</span>
        <span>from Spain</span>
      </div>
      <p class="copyright">{f.copyright}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    width: 100%;
    border-top: 1px solid var(--color-border, rgba(255, 255, 255, 0.09));
    background: var(--color-bg-base, #07080a);
    padding: 4.5rem 1.5rem 3rem;
    z-index: 10;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 860px) {
    .footer-top {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }

  .footer-brand {
    max-width: 360px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-text-primary, #ffffff);
  }

  .brand-logo {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  .brand-name {
    font-family: var(--font-mono, monospace);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary, #ffffff);
  }

  .brand-tagline {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-secondary, #94a3b8);
  }

  .footer-nav-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  @media (min-width: 600px) {
    .footer-nav-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .nav-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .nav-heading {
    margin: 0;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-primary, #ffffff);
  }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .nav-link {
    font-size: 0.9rem;
    color: var(--color-text-secondary, #94a3b8);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--color-accent, #4d80c4);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border, rgba(255, 255, 255, 0.06));
    font-size: 0.85rem;
    color: var(--color-text-muted, #64748b);
  }

  .footer-made-with {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-family: var(--font-mono, monospace);
    color: var(--color-text-muted, #94a3b8);
  }

  .heart-icon {
    display: inline-block;
    animation: heartPulse 2s ease-in-out infinite;
  }

  @keyframes heartPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.2); }
  }

  @media (min-width: 700px) {
    .footer-bottom {
      flex-direction: row;
    }
  }

  .copyright {
    margin: 0;
  }

</style>
