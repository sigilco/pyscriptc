---
import { useI18n } from "../i18n";

const i18n = useI18n();
const metrics = i18n.metrics || [
  {
    val: "24",
    unit: "x",
    label: "Faster Execution",
    desc: "Geometric mean speedup across compute kernels vs standard CPython.",
  },
  {
    val: "6",
    unit: "x",
    label: "Lower Peak Memory",
    desc: "Radically reduced RSS footprint. Pack more tasks onto leaner instances.",
  },
  {
    val: "0",
    unit: "ms",
    label: "Cold Start",
    desc: "Instant sub-millisecond execution for CLI tools, lambdas & serverless.",
  },
  {
    val: "100",
    unit: "%",
    label: "Standalone Binary",
    desc: "Single self-contained file. Zero dependencies, zero virtualenvs to ship.",
  },
];
---

<section class="metrics-section" aria-label="Key Performance Metrics">
  <div class="metrics-container">
    <div class="metrics-grid">
      {
        metrics.map((item, idx) => (
          <div class="metric-card" data-index={idx}>
            <div class="metric-top">
              <div class="metric-stat">
                <span class="metric-val">{item.val}</span>
                <span class="metric-unit">{item.unit}</span>
              </div>
              <div class="metric-indicator" aria-hidden="true" />
            </div>
            <div class="metric-label">{item.label}</div>
            <p class="metric-desc">{item.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .metrics-section {
    position: relative;
    width: 100%;
    padding: 2.5rem 1.5rem 4rem;
    z-index: 10;
  }

  .metrics-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    background: var(--color-bg-card, rgba(17, 22, 37, 0.75));
    border: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
    border-radius: 16px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow: hidden;
    box-shadow: 0 8px 32px -4px rgba(0, 0, 0, 0.4),
                0 0 0 1px rgba(0, 194, 255, 0.08);
  }

  @media (min-width: 900px) {
    .metrics-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .metric-card {
    position: relative;
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: background 0.25s ease, transform 0.2s ease;
  }

  /* Internal dividers between columns */
  .metric-card:not(:last-child) {
    border-right: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
  }

  /* Mobile 2x2 grid dividers */
  @media (max-width: 899px) {
    .metric-card:nth-child(2n) {
      border-right: none;
    }
    .metric-card:nth-child(1),
    .metric-card:nth-child(2) {
      border-bottom: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
    }
  }

  .metric-card:hover {
    background: rgba(0, 194, 255, 0.03);
  }

  .metric-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .metric-stat {
    display: flex;
    align-items: baseline;
    gap: 0.15rem;
  }

  .metric-val {
    font-family: var(--font-mono, monospace);
    font-size: 3.25rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    background: linear-gradient(135deg, #ffffff 40%, var(--color-accent-cyan, #00c2ff) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .metric-unit {
    font-family: var(--font-mono, monospace);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-accent-cyan, #00c2ff);
  }

  .metric-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent-cyan, #00c2ff);
    box-shadow: 0 0 10px var(--color-accent-cyan, #00c2ff);
    opacity: 0.7;
  }

  .metric-label {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text-primary, #ffffff);
    letter-spacing: -0.01em;
  }

  .metric-desc {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-secondary, #94a3b8);
  }
</style>
