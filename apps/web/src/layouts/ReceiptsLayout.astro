---
// The receipts part of the single pyscriptc site. Built with base "/receipts"
// so the deploy tree serves it at /receipts/ next to the landing page, /docs,
// /compat and /compare. The top navbar is the same floating pill bar the
// other pages use (HeaderPillNav), so all pages stay one site visually.
import React from "react";
import { HeaderPillNav } from "../components/HeaderPillNav";
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";
import "../styles/global.css";
import "../styles/receipts.css";

interface Props {
  title?: string;
}

const { title = "Per-target probe receipts · pyscriptc" } = Astro.props;
const description =
  "Run-and-match receipts per target: the probe programs pyscriptc compiles and runs on x86_64, aarch64 and wasm32, byte-compared against a pinned CPython 3.14 oracle.";
const url = "https://pyscriptc.pages.dev/receipts/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="64x64" href="/icon-64.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/logo-256.png" />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content="https://pyscriptc.pages.dev/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="pyscriptc: Compile annotated Python to a native binary. Logo and tagline on an obsidian card."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://pyscriptc.pages.dev/og-image.png" />
    <slot name="head" />
  </head>
  <body class="receipts-body">
    <HeaderPillNav client:load theme="dark" docsUrl="/docs/" compatUrl="/compat/" compareUrl="/compare/" receiptsUrl="/receipts/" />
    <div class="receipts-nav-spacer" aria-hidden="true"></div>
    <main class="container receipts-page">
      <slot />
    </main>
    <Footer />
    <footer class="receipts-data-footer">
      <p>
        Receipts measured nightly from the compiler tree —
        <a href="/receipts/data/receipts.json">receipts.json</a>
      </p>
    </footer>
    <Analytics />
  </body>
</html>
