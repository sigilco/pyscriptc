{
  "name": "pyscriptc-site",
  "private": true,
  "version": "0.0.0",
  "description": "The pyscriptc site: landing page, docs and compat page",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "docs:dev": "docmd dev",
    "docs:build": "docmd build",
    "docs:validate": "docmd validate",
    "docs:internal": "docmd dev --config docmd.internal.config.js",
    "compat:build": "uv run python compat/build.py",
    "site:build": "uv run python scripts/build_site.py",
    "site:check": "uv run python scripts/check_site_links.py --external"
  },
  "devDependencies": {
    "@docmd/core": "^0.9.5"
  }
}
