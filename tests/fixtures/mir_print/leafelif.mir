; module leafelif.py entry=__entry__

fn pick(v0:w) -> w {
  c0 = w 0
  c1 = w 1
  c2 = w 5
  c3 = w 2
  c4 = w 10
  c5 = w 3
  c6 = w 4
b0 entry():
  v1:w = copy v0
  v3:w = copy v1
  v4:b = cltw v3, c0
  br v4, b1(), b2()
b1 then():
  v2:w = copy c1
  jmp b9
b2 else():
  v5:w = copy v1
  v6:b = cltw v5, c2
  br v6, b3(), b4()
b3 then():
  v2:w = copy c3
  jmp b8
b4 else():
  v7:w = copy v1
  v8:b = cltw v7, c4
  br v8, b5(), b6()
b5 then():
  v2:w = copy c5
  jmp b7
b6 else():
  v2:w = copy c6
  jmp b7
b7 merge():
  jmp b8
b8 merge():
  jmp b9
b9 merge():
  v9:w = copy v2
  ret v9
}

fn grade(v0:w) -> w {
  c0 = w 50
  c1 = w 2
  c2 = w 75
  c3 = w 100
  c4 = w 1
b0 entry():
  v1:w = copy v0
  v3:w = copy v1
  v4:b = cltw v3, c0
  br v4, b1(), b2()
b1 then():
  v5:w = copy v1
  v6:w = mulw v5, c1
  v2:w = copy v6
  jmp b6
b2 else():
  v7:w = copy v1
  v8:b = cltw v7, c2
  br v8, b3(), b4()
b3 then():
  v9:w = copy v1
  v10:w = addw v9, c3
  v2:w = copy v10
  jmp b5
b4 else():
  v11:w = copy v1
  v12:w = subw v11, c4
  v2:w = copy v12
  jmp b5
b5 merge():
  jmp b6
b6 merge():
  v13:w = copy v2
  ret v13
}

fn dead_mid(v0:w) -> w {
  c0 = w 0
  c1 = w 1
  c2 = w 2
b0 entry():
  v1:w = copy v0
  v3:w = copy v1
  v4:b = cltw v3, c0
  br v4, b1(), b2()
b1 then():
  v2:w = copy c1
  jmp b6
b2 else():
  v5:w = copy v1
  v6:b = ceqw v5, c0
  br v6, b3(), b4()
b3 then():
  ret c0
b4 else():
  v2:w = copy c2
  jmp b5
b5 merge():
  jmp b6
b6 merge():
  v7:w = copy v2
  ret v7
}

fn main() -> void {
  c0 = w 1
  c1 = w 3
  c2 = w 7
  c3 = w 20
  c4 = w 10
  c5 = w 60
  c6 = w 90
  c7 = w 5
  c8 = w 0
